+    _SEQ_TIME_PATTERN = re.compile(
+        r'(?:第[一二三四五六七八九十\d]+[站步期天节次]|上午|下午|晚上|早晨|中午|凌晨|Day\s*\d|\d{1,2}:\d{2})',
+        re.IGNORECASE,
