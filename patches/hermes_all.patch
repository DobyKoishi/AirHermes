+        # Expand markdown links [text](url) -> "text\nurl"
+        def _expand_md(match):
+            title = match.group("text").strip()
+            url = match.group("url").strip().rstrip(self._TRAILING_PUNCT)
+            if title:
+                return f"{title}\n{url}\n"
+            return f"\n{url}\n"
