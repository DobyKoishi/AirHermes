+def match_semantic_icon(header_text: str) -> str:
+    """Match header keyword to semantic SVG symbol ID."""
+    text_lower = header_text.lower().strip()
+    for kw, icon_id in SEMANTIC_MAP.items():
+        if kw in text_lower:
+            return icon_id
+    return ""
+
+def render_use_icon(icon_id: str, extra_class: str = "") -> str:
+    """Render SVG <use> tag referencing an embedded symbol."""
+    if not icon_id:
+        return ""
+    cls_str = f"icon {extra_class}".strip()
+    return f'<svg class="{cls_str}" aria-hidden="true"><use href="#i-{icon_id}"/></svg>'
