+def _build_apple_tv_specs_html(
+    title: str = "",
+    original_title: str = "",
+    year: str = "",
+    runtime: str = "",
+    user_specs: str = "",
+    genres: str = "",
+    accent: str = "#D4AF37",
+) -> str:
+    """Generate authentic Apple TV specification badges with official vector logos (IMAX, Dolby, CINITY)."""
+    # 1. Format runtime (e.g. '180 分钟' -> '3h 00m')
+    mins = 0
+    m = re.search(r'(\d+)', runtime or "")
+    if m:
+        mins = int(m.group(1))
+    if mins > 0:
+        h = mins // 60
+        rem = mins % 60
+        duration_str = f"{h}h {rem:02d}m" if h > 0 else f"{rem}m"
+    else:
+        duration_str = runtime or "2h 35m"
+
+    year_str = year or "2023"
+
+    # 2. Match film tech specs & certifications
+    t_clean = f"{title} {original_title}".lower()
+
+    if any(k in t_clean for k in ["oppenheimer", "奥本海默"]):
+        cert = "16+"
+        logos = ["imax", "atmos"]
+        footnote = "IMAX 15/70mm 胶片全画幅 1.43:1 · 杜比全景声 7.1 · 柯达 65mm 特制底片母带"
+    elif any(k in t_clean for k in ["interstellar", "星际穿越"]):
+        cert = "12+"
+        logos = ["imax"]
+        footnote = "IMAX 70mm 原生画幅 1.43:1 · DTS-HD MA 5.1 环绕声 · 激光极清高动态修复"
+    elif any(k in t_clean for k in ["last emperor", "末代皇帝"]):
+        cert = "16+"
+        logos = ["vision", "atmos"]
+        footnote = "35mm 原生胶片 4K 独家数字修复 · 杜比视界 HDR · 杜比全景声 7.1.4 原声"
+    elif any(k in t_clean for k in ["godfather", "教父"]):
+        cert = "18+"
+        logos = ["vision", "atmos"]
+        footnote = "派拉蒙 50 周年 4K UHD 终极数字修复 · 杜比视界 HDR · 原始胶片单声道无损修复"
+    elif any(k in t_clean for k in ["dune", "沙丘"]):
+        cert = "12+"
+        logos = ["imax", "cinity", "vision", "atmos"]
+        footnote = "IMAX 1.43:1 特制画幅 · CINITY 4K 120fps 高光放映 · 杜比全景声沉浸声场"
+    elif any(k in t_clean for k in ["avatar", "阿凡达"]):
+        cert = "12+"
+        logos = ["cinity", "vision", "atmos"]
+        footnote = "CINITY 4K 3D 120fps 原生高帧率 · 杜比视界 HDR · 杜比全景声 9.1 声道母带"
+    elif any(k in t_clean for k in ["spirited away", "千与千寻"]):
+        cert = "6+"
+        logos = ["atmos"]
+        footnote = "吉卜力赛璐珞纯手绘原生胶片 · 久石让交响乐 24-bit 96kHz 环绕声母带"
+    else:
+        # Dynamic inference from user_specs / genres
+        s_clean = (user_specs or "").lower()
+        logos = []
+        if "imax" in s_clean or any(k in genres for k in ["科幻", "战争", "动作", "冒险"]):
+            logos.append("imax")
+        if "cinity" in s_clean:
+            logos.append("cinity")
+        if "vision" in s_clean or "hdr" in s_clean or not logos:
+            logos.append("vision")
+        if "atmos" in s_clean or "全景声" in s_clean or "sound" in s_clean:
+            logos.append("atmos")
+        cert = "12+"
+        footnote = user_specs or "4K UHD 原生母带 · 广色域高动态范围 · 无损多声道环绕声"
+
+    svg_dict = {
+        "imax": _OFFICIAL_SVG_IMAX,
+        "cinity": _OFFICIAL_SVG_CINITY,
+        "vision": _OFFICIAL_SVG_DOLBY_VISION,
+        "atmos": _OFFICIAL_SVG_DOLBY_ATMOS,
+    }
+
+    logo_spans = "".join([f'<span class="apple-logo-item">{svg_dict[l]}</span>' for l in logos if l in svg_dict])
+
+    return f"""
+    <div class="apple-tv-specs-wrapper">
+      <div class="apple-tv-badge-strip">
+        <span class="apple-tv-meta">{html.escape(year_str)} · {html.escape(duration_str)}</span>
+        <span class="apple-tv-rating">
+          <span class="rating-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span>
+          <span>{html.escape(cert)}</span>
+        </span>
+        <span class="apple-tv-pill">4K</span>
+        {logo_spans}
+        <span class="apple-tv-pill">CC</span>
+        <span class="apple-tv-pill">SDH</span>
+        <span class="apple-tv-pill">AD</span>
+      </div>
+      <div class="apple-tv-footnote">{html.escape(footnote)}</div>
+    </div>
+    """
+
 
