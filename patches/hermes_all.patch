+    @classmethod
+    def _prune_robotic_boilerplate(cls, text: str) -> str:
+        if not text or not isinstance(text, str):
+            return ""
+        res = text
+        matched_any = False
+        for p in cls._BOILERPLATE_PATTERNS:
+            if p.search(res):
+                res = p.sub("", res)
+                matched_any = True
+        if matched_any:
+            res = re.sub(r'[\s:：，,、-]+$', '', res)
+        return res.strip()
+    _CONTACT_RE = re.compile(
