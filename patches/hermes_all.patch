+
+:root {{
+  --blue: #1742ff;
+  --ink: #111521;
+  --muted: #59677f;
+  --light: #eef2fa;
+  --line: #d9e1f0;
+  --paper: #ffffff;
+  --white: #f8faff;
+  --green: #168069;
+  --amber: #ad6321;
+  --serif: 'Noto Serif SC', 'Playfair Display', serif;
+  --sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", "SF Pro Text", "Helvetica Neue", sans-serif;
+  --mono: 'JetBrains Mono', 'Space Grotesk', monospace;
+}}
+
+* {{ box-sizing: border-box; margin: 0; padding: 0; }}
+
+html, body {{
+  background: transparent;
+  color: var(--ink);
+  font-family: var(--sans);
+  -webkit-font-smoothing: antialiased;
+}}
+
+.sheet {{
+  width: {canvas_width}px;
+  background: var(--paper);
+  padding: 38px 44px 34px;
+  position: relative;
+  overflow: hidden;
+}}
+
+.sheet:before {{
+  content: "";
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background-image: 
+    linear-gradient(to right, rgba(23,66,255,.029) 1px, transparent 1px),
+    linear-gradient(to bottom, rgba(23,66,255,.029) 1px, transparent 1px);
+  background-size: 28px 28px;
+  z-index: 1;
+}}
+
+.sheet > * {{
+  position: relative;
+  z-index: 2;
+}}
+
+/* 报头区 */
+.masthead {{
+  border-top: 3px solid var(--blue);
+  padding-top: 18px;
+  margin-bottom: 18px;
+}}
+
+.eyebrow {{
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-weight: 650;
+  letter-spacing: .04em;
+  font-size: 11.5px;
+  color: var(--blue);
+  margin-bottom: 8px;
+}}
+
+.eyebrow .dash {{
+  width: 18px;
+  height: 2px;
+  background: currentColor;
+}}
+
+h1 {{
+  font: 800 clamp(28px, 3vw, 42px)/1.22 var(--serif);
+  letter-spacing: -.035em;
+  margin: 0 0 8px;
+  color: var(--ink);
+  max-width: 1200px;
+}}
+
+.lede {{
+  font-size: 14.5px;
+  color: var(--muted);
+  margin: 0;
+  line-height: 1.5;
+}}
+
+.context {{
+  display: flex;
+  justify-content: space-between;
+  gap: 25px;
+  align-items: flex-end;
+}}
+
+/* 矩阵网格系统 */
+.matrix-wrap {{
+  border-top: 2px solid var(--blue);
+  border-bottom: 2px solid var(--blue);
+}}
+
+.matrix {{
+  display: grid;
+  grid-template-columns: {grid_cols_css};
+}}
+
+.head {{
+  min-height: 62px;
+  display: flex;
+  gap: 8px;
+  align-items: center;
+  border-bottom: 1.5px solid var(--blue);
+  padding: 13px 13px;
+  color: var(--ink);
+  font-size: 13.5px;
+  font-weight: 700;
+  line-height: 1.4;
+  background: rgba(248,250,255,.86);
+}}
+
+.head svg {{
+  color: var(--blue);
+  width: 19px;
+  height: 19px;
+  flex: none;
+}}
+
+.head:not(:first-child) {{
+  border-left: 1px solid var(--line);
+}}
+
+.head.first {{
+  padding-left: 19px;
+  background: #edf2ff;
+}}
+
+.record {{
+  display: contents;
+}}
+
+.cell {{
+  padding: 13px 13px 13px;
+  border-bottom: 1px solid var(--line);
+  min-height: 48px;
+  font-size: 13.5px;
+  line-height: 1.5;
+  min-width: 0;
+  word-break: normal;
+  overflow-wrap: break-word;
+}}
+
+.record:last-child .cell {{
+  border-bottom: 0;
+}}
+
+.cell:not(.identity) {{
+  border-left: 1px solid var(--line);
+}}
+
+.cell.identity {{
+  background: rgba(238,243,255,.72);
+  border-right: 2px solid var(--blue);
+  padding: 16px 18px 16px;
+}}
+
+.identity .rank {{
+  color: var(--blue);
+  font-family: var(--mono);
+  font-size: 11px;
+  font-weight: 750;
+  letter-spacing: .1em;
+  margin-bottom: 6px;
+}}
+
+.identity .name {{
+  font: 750 21px/1.24 var(--serif);
+  letter-spacing: -.03em;
+  color: var(--ink);
+  overflow-wrap: anywhere;
+}}
+
+.identity .descriptor {{
+  margin-top: 6px;
+  color: var(--muted);
+  font-size: 12px;
+}}
+
+/* 数据单元格样式：稳定层级，和谐克制 */
+.number {{
+  font: 650 25px/1.15 var(--sans);
+  font-family: var(--mono);
+  font-variant-numeric: tabular-nums;
+  letter-spacing: -.04em;
+  color: var(--ink);
+}}
+
+.number .unit {{
+  font-family: var(--sans);
+  font-size: 12.5px;
+  font-weight: 550;
+  letter-spacing: 0;
+  margin-left: 3px;
+  color: var(--muted);
+}}
+
+.number.midsize {{
+  font-size: 23px;
+}}
+
+.sub {{
+  color: var(--muted);
+  font-size: 12px;
+  line-height: 1.45;
+  margin-top: 4px;
+}}
+
+.keyline {{
+  width: 100%;
+  height: 3.5px;
+  background: #e2e8f4;
+  margin: 7px 0 6px;
+}}
+
+.keyline span {{
+  display: block;
+  background: var(--blue);
+  height: 100%;
+}}
+
+.status {{
+  display: flex;
+  gap: 6px;
+  align-items: center;
+  font-weight: 650;
+  color: var(--ink);
+  font-size: 13px;
+}}
+
+.status.partial {{
+  color: var(--ink);
+}}
+
+.status.missing {{
+  color: #7f8da2;
+  font-weight: 450;
+}}
+
+.status .icon {{
+  width: 17px;
+  height: 17px;
+  flex: none;
+}}
+
+.price {{
+  font: 650 24px/1.15 var(--sans);
+  font-family: var(--mono);
+  font-variant-numeric: tabular-nums;
+  letter-spacing: -.035em;
+  color: var(--ink);
+}}
+
+.price .currency {{
+  font-size: 15px;
+  vertical-align: 1px;
+  margin-right: 2px;
+  color: var(--blue);
+}}
+
+.fit {{
+  font-size: 13.5px;
+  line-height: 1.55;
+  color: #354159;
+  overflow-wrap: anywhere;
+}}
+
+.fit strong {{
+  display: block;
+  color: var(--ink);
+  font-size: 13.5px;
+  font-weight: 720;
+  margin-bottom: 3px;
+}}
+
+/* SVG 图标通用类 */
+.icon {{
+  width: 19px;
+  height: 19px;
+  flex: none;
+  stroke: currentColor;
