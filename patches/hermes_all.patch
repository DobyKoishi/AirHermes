+    @staticmethod
+    def _parse_tag_attrs(attr_str: str) -> dict[str, str]:
+        if not attr_str:
+            return {}
+        matches = re.findall(r'([a-zA-Z0-9_\-]+)\s*=\s*["\']([^"\']*)["\']', attr_str)
+        return {k.lower(): v for k, v in matches}
